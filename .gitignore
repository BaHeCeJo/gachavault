# Rust build artifacts
target/

# Environment files - never commit secrets
.env
.env.local
.env.prod
*.env.local

# Node.js
node_modules/
web/.next/
web/out/
web/.env.local

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Uploads (local media storage)
uploads/

# Docker secrets - per-host populated, never committed
secrets/

# TS incremental build cache - regenerated on every build, no value in git
*.tsbuildinfo

# Claude Code per-machine settings (the shared .claude/settings.json IS tracked)
.claude/settings.local.json

# Python bytecode from the seed/transform scripts
__pycache__/
*.pyc

# Seed data - scraped caches and import files, local-only. Two exceptions:
# the README documents how to run the pipeline, and the scaling fixtures are a
# hand-written test fixture that skillScaling.test.ts reads in CI.
seed_data/*
!seed_data/README.md
!seed_data/scaling_extraction_fixtures.json
