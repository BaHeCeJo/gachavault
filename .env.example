# ============================================================
# GachaVault — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.
# ============================================================

# --- Database ---
POSTGRES_PASSWORD=change_me_strong_password

# --- Per-service DB users (created by scripts/db-create-service-users.sh) ---
# Run that script once after first `docker compose up`, then restart services.
AUTH_SVC_PASSWORD=change_me_auth_svc_password
GAMES_SVC_PASSWORD=change_me_games_svc_password
ITEMS_SVC_PASSWORD=change_me_items_svc_password
COLLECTIONS_SVC_PASSWORD=change_me_collections_svc_password
TIERLISTS_SVC_PASSWORD=change_me_tierlists_svc_password
MEDIA_SVC_PASSWORD=change_me_media_svc_password

# --- Redis (used in production; not required for local dev) ---
REDIS_PASSWORD=change_me_redis_password

# --- JWT (minimum 32 random characters) ---
JWT_SECRET=change_me_at_least_32_chars_random_string

# --- Internal service auth ---
# Shared secret for service-to-service calls (not user-facing)
INTERNAL_SECRET=change_me_internal_service_secret

# --- Google OAuth ---
# Get from https://console.cloud.google.com/ → APIs & Services → Credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# --- Meilisearch ---
MEILISEARCH_MASTER_KEY=change_me_meilisearch_master_key

# --- Email (SMTP) ---
# Recommended: Resend (resend.com) — free tier, 3000 emails/month
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USERNAME=resend
SMTP_PASSWORD=re_your_resend_api_key
FROM_EMAIL=noreply@gachavault.com

# --- URLs ---
FRONTEND_URL=http://localhost:3009
# BACKEND_URL is the public URL of the API gateway (used by auth-service for OAuth redirect URIs in prod)
BACKEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000

# --- Production only: GitHub Container Registry owner ---
# Set to your GitHub username/org when deploying
GHCR_OWNER=your_github_username
