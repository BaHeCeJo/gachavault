# ── Copy this to /opt/gachavault/.env on your VPS and fill in real values ─────

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=change_me_strong_password_here

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=change_me_redis_password_here

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=change_me_min_32_chars_random_string_here
JWT_EXPIRY_SECONDS=900
REFRESH_TOKEN_EXPIRY_DAYS=7

# ── Internal service auth ─────────────────────────────────────────────────────
INTERNAL_SECRET=change_me_another_32_chars_random_string

# ── Google OAuth (get from console.cloud.google.com) ─────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Meilisearch ───────────────────────────────────────────────────────────────
MEILISEARCH_MASTER_KEY=change_me_meilisearch_key_here

# ── SMTP — use any provider: Brevo (free 300/day), Mailgun, SES, etc. ─────────
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=your_smtp_username
SMTP_PASSWORD=your_smtp_password
FROM_EMAIL=noreply@yourdomain.com

# ── URLs — replace yourdomain.com with your actual domain ─────────────────────
FRONTEND_URL=https://yourdomain.com
BACKEND_URL=https://yourdomain.com

# ── GitHub Container Registry owner (your GitHub username/org) ───────────────
GHCR_OWNER=your_github_username
